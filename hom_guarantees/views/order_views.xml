<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_hom_guarantees" model="ir.ui.view">
        <field name="name">sale.order.form.hom.guarantees</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hom_guarantees" type="object" class="oe_stat_button" icon="fa-shield"
                        invisible="hom_project_type != 'contracting'">
                    <field name="hom_guarantee_count" widget="statinfo" string="Guarantees"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_hom_guarantees" model="ir.ui.view">
        <field name="name">purchase.order.form.hom.guarantees</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hom_guarantees" type="object" class="oe_stat_button" icon="fa-shield"
                        invisible="not hom_is_subcontract">
                    <field name="hom_guarantee_count" widget="statinfo" string="Guarantees"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
