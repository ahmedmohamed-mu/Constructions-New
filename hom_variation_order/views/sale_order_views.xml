<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_hom_variations" model="ir.ui.view">
        <field name="name">sale.order.form.hom.variations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hom_variations" type="object" class="oe_stat_button" icon="fa-exchange"
                        invisible="hom_project_type != 'contracting' or state != 'sale'">
                    <field name="hom_variation_count" widget="statinfo" string="Variations"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
