<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zc_project_plan_template_list" model="ir.ui.view">
        <field name="name">zc.project.plan.template.list</field>
        <field name="model">zc.project.plan.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="zc_project_plan_template_form" model="ir.ui.view">
        <field name="name">zc.project.plan.template.form</field>
        <field name="model">zc.project.plan.template</field>
        <field name="arch" type="xml">
            <form string="Project Plan Template">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Finishing project"/></h1></div>
                    <group>
                        <group><field name="is_default"/></group>
                        <group><field name="active" invisible="1"/></group>
                    </group>
                    <div class="text-muted mb-2">Dates are a % of the project duration: 0% is the start date, 100%
                        the end date. Execution tasks are made per BOQ item and follow the quantities measured on site.</div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="phase"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="role"/>
                            <field name="start_pct" invisible="kind in ('milestone', 'monthly')"/>
                            <field name="end_pct" invisible="kind == 'monthly'"/>
                            <field name="extra_months" optional="hide"/>
                            <field name="chain" optional="hide"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zc_project_plan_template" model="ir.actions.act_window">
        <field name="name">Project Plan Templates</field>
        <field name="res_model">zc.project.plan.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_zc_project_plan_template" name="Project Plan Templates" parent="project.menu_project_config"
              action="action_zc_project_plan_template" sequence="5"/>

    <record id="edit_project_zc_plan" model="ir.ui.view">
        <field name="name">project.project.form.zc.plan</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="task_count" invisible="1"/>
                <button name="action_zc_load_plan" type="object" string="Load project plan" class="btn-secondary"
                        invisible="task_count"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="zc_plan_template_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
