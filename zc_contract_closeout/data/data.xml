<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_zc_handover" model="ir.sequence">
            <field name="name">Handover Minutes</field>
            <field name="code">zc.handover</field>
            <field name="prefix">HO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_zc_dlp_reminder" model="ir.cron">
            <field name="name">Contracting: defects liability period ending</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._zc_cron_dlp_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
