<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_zc_wir" model="ir.sequence">
        <field name="name">Work Inspection Request</field>
        <field name="code">zc.inspection.request</field>
        <field name="prefix">WIR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_zc_dispute" model="ir.sequence">
        <field name="name">Quantity Claim</field>
        <field name="code">zc.quantity.dispute</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
