<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_zc_cc" model="ir.ui.view">
        <field name="name">stock.picking.form.zc.cc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="zc_charge_partner_id" invisible="picking_type_code != 'outgoing'"
                       domain="[('supplier_rank', '&gt;', 0)]"/>
                <field name="zc_charge_deduction_id" invisible="not zc_charge_deduction_id"/>
                <field name="zc_company_currency_id" invisible="1"/>
                <field name="zc_charge_amount" invisible="not zc_charge_partner_id or state != 'done'"/>
            </xpath>
        </field>
    </record>
</odoo>
