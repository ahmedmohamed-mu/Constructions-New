<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_zc_return_alerts" model="ir.cron">
        <field name="name">Material Control: supplier return alerts</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._zc_cron_return_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_zc_interval_certificates" model="ir.cron">
        <field name="name">Contracting: certificates every N days</field>
        <field name="model_id" ref="hom_progress_billing.model_hom_progress_certificate"/>
        <field name="state">code</field>
        <field name="code">model._zc_cron_interval_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
