<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hom.contracting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Contracting (Progress Certificates)" name="hom_contracting">
                    <setting string="Top management" help="Receives budget overrun and margin alerts (usually the CEO)">
                        <field name="hom_management_user_id"/>
                    </setting>
                    <setting string="Zero-touch invoicing" help="Approved certificates create their draft invoice / vendor bill automatically; the accountant only reviews and posts">
                        <field name="hom_auto_draft_invoice"/>
                    </setting>
                    <setting string="Owner retention" help="Line withheld on owner certificates">
                        <field name="hom_retention_owner_product_id"/>
                    </setting>
                    <setting string="Subcontractor retention" help="Line withheld on subcontractor certificates">
                        <field name="hom_retention_sub_product_id"/>
                    </setting>
                    <setting string="Subcontractor advance" help="Advance bill and its recovery">
                        <div class="row"><label for="hom_sub_advance_product_id" class="col-lg-4 o_light_label"/><field name="hom_sub_advance_product_id"/></div>
                        <div class="row"><label for="hom_sub_advance_recovery_product_id" class="col-lg-4 o_light_label"/><field name="hom_sub_advance_recovery_product_id"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
