        <record id="seq_zc_daily_report" model="ir.sequence">
            <field name="name">Site Daily Report</field>
            <field name="code">zc.daily.report</field>
            <field name="prefix">DSR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_zc_rfi" model="ir.sequence">
            <field name="name">Request for Information</field>
            <field name="code">zc.rfi</field>
            <field name="prefix">RFI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_zc_ncr" model="ir.sequence">
            <field name="name">Non-Conformance Report</field>
            <field name="code">zc.ncr</field>
            <field name="prefix">NCR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
