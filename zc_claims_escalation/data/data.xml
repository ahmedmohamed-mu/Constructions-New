<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_zc_claim" model="ir.sequence">
        <field name="name">Contractor Claim</field>
        <field name="code">zc.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_zc_escalation" model="ir.sequence">
        <field name="name">Price Escalation</field>
        <field name="code">zc.escalation</field>
        <field name="prefix">ESC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
