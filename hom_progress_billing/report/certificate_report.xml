<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_progress_certificate" model="ir.actions.report">
        <field name="name">Progress Certificate (مستخلص جاري)</field>
        <field name="model">hom.progress.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hom_progress_billing.report_progress_certificate</field>
        <field name="print_report_name">'مستخلص - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hom_progress_certificate"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_progress_certificate_document">
        <t t-call="web.external_layout">
            <t t-set="F" t-value="{'widget': 'float', 'precision': 2}"/>
            <t t-set="M" t-value="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            <div class="page" dir="rtl" style="text-align:right">
                <h2>مستخلص جاري رقم <span t-out="o.number"/></h2>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td><strong>صاحب العمل:</strong> <span t-out="o.partner_id.name"/></td>
                        <td><strong>الاستشاري:</strong> <span t-out="o.consultant_id.name or '-'"/></td>
                        <td><strong>العقد:</strong> <span t-out="o.sale_order_id.name"/></td>
                        <td><strong>التاريخ:</strong> <span t-field="o.date"/></td>
                    </tr>
                </table>
                <h5>أولًا: الأعمال المنفذة</h5>
                <table class="table table-sm table-bordered">
                    <thead><tr>
                        <th style="width:34%">البند</th><th>الوحدة</th><th class="text-end">كمية العقد</th>
                        <th class="text-end">السابق</th><th class="text-end">الحالي</th><th class="text-end">التراكمي</th>
                        <th class="text-end">الفئة</th><th class="text-end">قيمة الحالي</th><th class="text-end">نسبة الإنجاز</th>
                    </tr></thead>
                    <tbody>
                        <t t-foreach="o.line_ids" t-as="l">
                            <tr>
                                <td><span t-out="l.product_id.with_context(lang='ar_001').name"/></td>
                                <td><span t-out="l.product_uom_id.name"/></td>
                                <td class="text-end"><span t-out="l.contract_qty" t-options="F"/></td>
                                <td class="text-end"><span t-out="l.previous_qty" t-options="F"/></td>
                                <td class="text-end"><span t-out="l.current_qty" t-options="F"/></td>
                                <td class="text-end"><span t-out="l.cumulative_qty" t-options="F"/></td>
                                <td class="text-end"><span t-out="l.price_unit" t-options="F"/></td>
                                <td class="text-end"><span t-out="l.amount_current" t-options="M"/></td>
                                <td class="text-end"><span t-out="round(l.progress_pct, 1)"/> %</td>
                            </tr>
                        </t>
                        <tr class="fw-bold"><td colspan="7">إجمالي الأعمال الحالية</td><td class="text-end"><span t-out="o.amount_current" t-options="M"/></td><td/></tr>
                    </tbody>
                </table>
                <h5>ثانيًا: الخصومات التعاقدية</h5>
                <table class="table table-sm" style="width:60%">
                    <tr><td>استرداد الدفعة المقدمة (<span t-out="'%g' % o.advance_pct"/>%)</td><td class="text-end"><span t-out="o.amount_advance_recovery" t-options="M"/></td></tr>
                    <tr><td>محتجز ضمان الأعمال (<span t-out="'%g' % o.retention_pct"/>%)</td><td class="text-end"><span t-out="o.amount_retention" t-options="M"/></td></tr>
                    <tr class="fw-bold"><td>الصافي قبل الضريبة</td><td class="text-end"><span t-out="o.amount_net" t-options="M"/></td></tr>
                    <tr><td>إجمالي الأعمال التراكمية حتى تاريخه</td><td class="text-end"><span t-out="o.amount_cumulative" t-options="M"/></td></tr>
                    <tr><td>نسبة إنجاز العقد</td><td class="text-end"><span t-out="round(o.progress_pct, 1)"/> %</td></tr>
                </table>
                <div class="row mt-5 text-center">
                    <div class="col-3">مهندس الموقع<br/><br/>..............</div>
                    <div class="col-3">مدير المشروع<br/><br/>..............</div>
                    <div class="col-3">اعتماد الاستشاري<br/><br/>..............</div>
                    <div class="col-3">اعتماد صاحب العمل<br/><br/>..............</div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_progress_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="hom_progress_billing.report_progress_certificate_document" t-lang="'ar_001'"/>
            </t>
        </t>
    </template>
</odoo>
