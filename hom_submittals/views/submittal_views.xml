<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hom_submittal_form" model="ir.ui.view">
        <field name="name">hom.submittal.form</field>
        <field name="model">hom.submittal</field>
        <field name="arch" type="xml">
            <form string="Submittal">
                <header>
                    <button name="action_submit" type="object" string="Submit to Consultant" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_code_a" type="object" string="A - Approved" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_code_b" type="object" string="B - Approved as noted" class="btn-secondary" invisible="state != 'submitted'"/>
                    <button name="action_code_c" type="object" string="C - Revise" class="btn-warning" invisible="state != 'submitted'"/>
                    <button name="action_code_d" type="object" string="D - Rejected" class="btn-danger" invisible="state != 'submitted'"/>
                    <button name="action_resubmit" type="object" string="New Revision" class="btn-primary" invisible="state not in ('revise', 'rejected')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Code A" bg_color="text-bg-success" invisible="review_code != 'A'"/>
                    <widget name="web_ribbon" title="Code B" bg_color="text-bg-success" invisible="review_code != 'B'"/>
                    <widget name="web_ribbon" title="Code C" bg_color="text-bg-warning" invisible="review_code != 'C'"/>
                    <widget name="web_ribbon" title="Code D" bg_color="text-bg-danger" invisible="review_code != 'D'"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" class="oe_inline"/> · Rev. <field name="revision" class="oe_inline"/></div>
                        <h1><field name="title" placeholder="e.g. Chilled water pipe insulation sample"/></h1>
                    </div>
                    <group>
                        <group string="Submittal">
                            <field name="submittal_type"/>
                            <field name="project_id"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                            <field name="consultant_id"/>
                            <field name="trade_account_id"/>
                            <field name="product_id" invisible="submittal_type not in ('material', 'sample')"/>
                            <field name="purchase_order_id" invisible="submittal_type not in ('material', 'sample')"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Review">
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="submitted_date"/>
                            <field name="review_days"/>
                            <field name="due_date" decoration-danger="is_overdue"/>
                            <field name="days_overdue" invisible="not is_overdue" decoration-danger="1"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="returned_date" invisible="not returned_date"/>
                            <field name="review_code" invisible="not review_code"/>
                            <field name="previous_id" invisible="not previous_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consultant Comments" name="comments">
                            <field name="consultant_comments" placeholder="Comments returned with the review code..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hom_submittal_list" model="ir.ui.view">
        <field name="name">hom.submittal.list</field>
        <field name="model">hom.submittal</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state == 'superseded'" decoration-success="state == 'approved'">
                <field name="name"/>
                <field name="revision" string="Rev."/>
                <field name="title"/>
                <field name="submittal_type"/>
                <field name="project_id" optional="show"/>
                <field name="trade_account_id" optional="show"/>
                <field name="consultant_id" optional="hide"/>
                <field name="responsible_id" widget="many2one_avatar_user" optional="show"/>
                <field name="submitted_date" optional="show"/>
                <field name="due_date"/>
                <field name="days_overdue" optional="show"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="review_code" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'approved'"
                       decoration-warning="state == 'revise'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="hom_submittal_kanban" model="ir.ui.view">
        <field name="name">hom.submittal.kanban</field>
        <field name="model">hom.submittal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="is_overdue"/>
                <field name="days_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="text-muted small"/>
                            <field name="review_code" class="fw-bold"/>
                        </div>
                        <field name="title" class="fw-bold"/>
                        <field name="project_id" class="small text-muted"/>
                        <div t-if="record.is_overdue.raw_value" class="small text-danger fw-bold">
                            <t t-out="record.days_overdue.value"/> d late
                        </div>
                        <footer>
                            <field name="submittal_type" class="small"/>
                            <field name="responsible_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hom_submittal_search" model="ir.ui.view">
        <field name="name">hom.submittal.search</field>
        <field name="model">hom.submittal</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="consultant_id"/>
                <field name="product_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'submitted', 'revise'))]"/>
                <filter name="with_consultant" string="With Consultant" domain="[('state', '=', 'submitted')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="current" string="Current Revision" domain="[('state', '!=', 'superseded')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'submittal_type'}"/>
                <filter name="group_trade" string="Trade" context="{'group_by': 'trade_account_id'}"/>
                <filter name="group_code" string="Review Code" context="{'group_by': 'review_code'}"/>
            </search>
        </field>
    </record>

    <record id="action_hom_submittal" model="ir.actions.act_window">
        <field name="name">Submittals</field>
        <field name="res_model">hom.submittal</field>
        <field name="view_mode">list,kanban,form,pivot</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log a shop drawing or material submittal</p>
            <p>Track what is with the consultant, the review code (A/B/C/D), the revisions and what is late.</p>
        </field>
    </record>

    <record id="view_project_form_hom_submittals" model="ir.ui.view">
        <field name="name">project.project.form.hom.submittals</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_hom_submittals" type="object" class="oe_stat_button" icon="list_alt">
                    <field name="hom_submittal_open_count" widget="statinfo" string="Submittals"/>
                </button>
            </div>
        </field>
    </record>

    <menuitem id="menu_hom_submittals_root" name="Submittals" parent="hom_contracting_base.menu_hom_site_top"
              action="action_hom_submittal" sequence="20"/>
    <menuitem id="menu_hom_submittals_project" name="Submittals" parent="project.menu_main_pm"
              action="action_hom_submittal" sequence="30"/>
</odoo>
