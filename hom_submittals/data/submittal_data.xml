<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_hom_submittal" model="ir.sequence">
        <field name="name">Submittal</field>
        <field name="code">hom.submittal</field>
        <field name="prefix">SUB-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="cron_submittal_overdue" model="ir.cron">
        <field name="name">Contracting: submittals overdue at the consultant</field>
        <field name="model_id" ref="model_hom_submittal"/>
        <field name="state">code</field>
        <field name="code">model._cron_overdue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
