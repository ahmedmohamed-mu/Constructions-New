<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zc_my_work_form" model="ir.ui.view">
        <field name="name">zc.my.work.form</field>
        <field name="model">zc.my.work</field>
        <field name="arch" type="xml">
            <form string="My Work" create="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="user_id" readonly="1" options="{'no_open': True}"/></h1>
                        <div class="text-muted"><field name="date" readonly="1"/> · <field name="total"/> items waiting</div>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" decoration-danger="level == 'danger'"
                              decoration-warning="level == 'warning'">
                            <field name="role" widget="badge"/>
                            <field name="name"/>
                            <field name="count"/>
                            <field name="level" column_invisible="1"/>
                            <button name="action_open" type="object" string="Open" icon="fa-arrow-right"/>
                        </list>
                    </field>
                    <div class="text-muted small" invisible="line_ids">Nothing is waiting for you.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zc_my_work" model="ir.actions.server">
        <field name="name">My Work</field>
        <field name="model_id" ref="model_zc_my_work"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_zc_my_work" name="My Work" parent="hom_contracting_base.menu_hom_root"
              action="action_zc_my_work" sequence="0"/>
</odoo>
